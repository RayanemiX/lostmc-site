# Discord Developer Portal > ton appli > Bot > Token
DISCORD_TOKEN=

# Supabase > Project Settings > API
SUPABASE_URL=https://TON-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # clé "service_role" — SECRÈTE, jamais dans le site web !

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'ID)
